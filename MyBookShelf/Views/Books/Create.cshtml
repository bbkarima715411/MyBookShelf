@model MyBookShelf.UI.ViewModels.BookCreateViewModel

@{
    ViewData["Title"] = "Ajouter";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Ajouter un livre</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Retour</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Title"></label>
                <input class="form-control" asp-for="Title" />
                <span class="text-danger" asp-validation-for="Title"></span>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Author"></label>
                <input class="form-control" asp-for="Author" />
                <span class="text-danger" asp-validation-for="Author"></span>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label" asp-for="Status"></label>
                <select class="form-select" asp-for="Status">
                    <option value="0">À lire</option>
                    <option value="1">En cours</option>
                    <option value="2">Lu</option>
                    <option value="3">Abandonné</option>
                </select>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label" asp-for="Rating"></label>
                <input class="form-control" asp-for="Rating" type="number" min="1" max="5" aria-describedby="rating-help" />
                <div id="rating-help" class="form-text">Laissez vide si vous ne souhaitez pas noter ce livre.</div>
                <span class="text-danger" asp-validation-for="Rating"></span>
            </div>

            <div class="col-12 col-md-4 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" asp-for="IsFavorite" />
                    <label class="form-check-label" asp-for="IsFavorite">Ajouter aux favoris</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="Comment"></label>
                <textarea class="form-control" asp-for="Comment" rows="3" aria-describedby="comment-help"></textarea>
                <div id="comment-help" class="form-text">Visible uniquement par vous.</div>
                <span class="text-danger" asp-validation-for="Comment"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Ajouter</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
