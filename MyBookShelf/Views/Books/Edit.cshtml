@model MyBookShelf.Common1.Models.Book

@{
    ViewData["Title"] = "Éditer";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Éditer le livre</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Retour</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Title"></label>
                <input class="form-control" asp-for="Title" />
                <span class="text-danger" asp-validation-for="Title"></span>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Author"></label>
                <input class="form-control" asp-for="Author" />
                <span class="text-danger" asp-validation-for="Author"></span>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label" asp-for="Status"></label>
                <select class="form-select" asp-for="Status">
                    <option value="0">À lire</option>
                    <option value="1">En cours</option>
                    <option value="2">Lu</option>
                </select>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label" asp-for="Rating">Appréciation (1-5)</label>
                <input class="form-control" asp-for="Rating" type="number" min="1" max="5" />
                <span class="text-danger" asp-validation-for="Rating"></span>
            </div>

            <div class="col-12">
                <label class="form-label" asp-for="Comment">Commentaire</label>
                <textarea class="form-control" asp-for="Comment" rows="3"></textarea>
                <span class="text-danger" asp-validation-for="Comment"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
