@model List<MyBookShelf.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">MyBookShelf</h1>
        <div class="text-muted">Ta liste de lecture</div>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Create">Ajouter un livre</a>
    </div>
</div>

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label">Filtrer par statut</label>
            <select class="form-select" name="status">
                <option value="" selected="@(ViewBag.SelectedStatus == null)">Tous</option>
                <option value="0" selected="@(ViewBag.SelectedStatus != null && (int)ViewBag.SelectedStatus == 0)">À lire</option>
                <option value="1" selected="@(ViewBag.SelectedStatus != null && (int)ViewBag.SelectedStatus == 1)">En cours</option>
                <option value="2" selected="@(ViewBag.SelectedStatus != null && (int)ViewBag.SelectedStatus == 2)">Lu</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <button class="btn btn-outline-secondary w-100" type="submit">Filtrer</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Statut</th>
                    <th>Note</th>
                    <th>Commentaire</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td class="fw-semibold">@book.Title</td>
                        <td>@book.Author</td>
                        <td>
                            @if (book.Status == MyBookShelf.Models.BookStatus.ToRead)
                            {
                                <span class="badge text-bg-secondary">À lire</span>
                            }
                            else if (book.Status == MyBookShelf.Models.BookStatus.Reading)
                            {
                                <span class="badge text-bg-warning">En cours</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Lu</span>
                            }
                        </td>
                        <td>@(book.Rating?.ToString() ?? "—")</td>
                        <td class="text-truncate" style="max-width: 260px;">@(string.IsNullOrWhiteSpace(book.Comment) ? "—" : book.Comment)</td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap gap-2 justify-content-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@book.Id">Éditer</a>

                                <form asp-action="UpdateStatus" method="post" class="d-inline-flex gap-2">
                                    <input type="hidden" name="id" value="@book.Id" />
                                    <select class="form-select form-select-sm" name="status">
                                        <option value="0" selected="@(book.Status == MyBookShelf.Models.BookStatus.ToRead)">À lire</option>
                                        <option value="1" selected="@(book.Status == MyBookShelf.Models.BookStatus.Reading)">En cours</option>
                                        <option value="2" selected="@(book.Status == MyBookShelf.Models.BookStatus.Read)">Lu</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">OK</button>
                                </form>

                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@book.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
