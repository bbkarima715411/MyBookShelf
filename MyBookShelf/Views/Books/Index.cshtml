@model MyBookShelf.UI.ViewModels.BookListViewModel
@using MyBookShelf.Models

@{
    ViewData["Title"] = "Ma bibliothèque";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/books.css" asp-append-version="true" />
}

@functions {
    private static string StatusLabel(BookStatus status) => status switch
    {
        BookStatus.ToRead => "À lire",
        BookStatus.Reading => "En cours",
        BookStatus.Read => "Lu",
        BookStatus.Abandoned => "Abandonné",
        _ => "Inconnu"
    };

    private static string StatusBadgeClass(BookStatus status) => status switch
    {
        BookStatus.ToRead => "text-bg-secondary",
        BookStatus.Reading => "text-bg-warning",
        BookStatus.Read => "text-bg-success",
        BookStatus.Abandoned => "text-bg-dark",
        _ => "text-bg-secondary"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Ma bibliothèque</h1>
        <div class="text-muted">Vos lectures, à votre rythme</div>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Create">Ajouter un livre</a>
    </div>
</div>

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-3">
            <label class="form-label" for="filter-title">Titre</label>
            <input class="form-control" id="filter-title" name="Title" value="@Model.Filter.Title" placeholder="Rechercher un titre" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label" for="filter-author">Auteur</label>
            <input class="form-control" id="filter-author" name="Author" value="@Model.Filter.Author" placeholder="Rechercher un auteur" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label" for="filter-status">Statut</label>
            <select class="form-select" id="filter-status" name="Status">
                <option value="" selected="@(Model.Filter.Status == null)">Tous</option>
                <option value="0" selected="@(Model.Filter.Status == BookStatus.ToRead)">À lire</option>
                <option value="1" selected="@(Model.Filter.Status == BookStatus.Reading)">En cours</option>
                <option value="2" selected="@(Model.Filter.Status == BookStatus.Read)">Lu</option>
                <option value="3" selected="@(Model.Filter.Status == BookStatus.Abandoned)">Abandonné</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="filter-favorites" name="FavoritesOnly" value="true" checked="@Model.Filter.FavoritesOnly" />
                <label class="form-check-label" for="filter-favorites">Favoris uniquement</label>
            </div>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button class="btn btn-outline-secondary flex-fill" type="submit">Rechercher</button>
            @if (Model.Filter.HasActiveFilters)
            {
                <a class="btn btn-link" asp-action="Index">Réinitialiser</a>
            }
        </div>
    </div>
</form>

@if (Model.IsEmptyLibrary)
{
    <div class="card msb-empty">
        <h2 class="h5">Votre bibliothèque est encore vide</h2>
        <p class="text-muted mb-3">Ajoutez votre premier livre pour commencer à suivre vos lectures.</p>
        <div>
            <a class="btn btn-primary" asp-action="Create">Ajouter un livre</a>
        </div>
    </div>
}
else if (Model.IsEmptySearchResult)
{
    <div class="card msb-empty">
        <h2 class="h5">Aucun livre ne correspond à votre recherche</h2>
        <p class="text-muted mb-3">Essayez d'autres critères ou réinitialisez les filtres.</p>
        <div>
            <a class="btn btn-outline-secondary" asp-action="Index">Réinitialiser les filtres</a>
        </div>
    </div>
}
else
{
    @if (Model.Filter.HasActiveFilters)
    {
        <p class="filters-summary" role="status">
            @(Model.Books.Count == 1 ? "1 livre correspond" : $"{Model.Books.Count} livres correspondent") à vos critères.
            <a asp-action="Index">Réinitialiser les filtres</a>
        </p>
    }

    <div class="row g-3">
        @foreach (var book in Model.Books)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <article class="card book-card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge badge-status @StatusBadgeClass(book.Status)">@StatusLabel(book.Status)</span>
                            @if (book.IsFavorite)
                            {
                                <span class="badge badge-favorite">Favori</span>
                            }
                        </div>
                        <h2 class="book-title">@book.Title</h2>
                        <p class="book-author">@book.Author</p>
                        @if (book.Rating.HasValue)
                        {
                            <p class="book-rating mb-0">Note : @book.Rating sur 5</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(book.Comment))
                        {
                            <p class="book-comment">@book.Comment</p>
                        }
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@book.Id">Modifier</a>

                        <form asp-action="ToggleFavorite" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@book.Id" />
                            @if (book.IsFavorite)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Retirer « @book.Title » des favoris">Retirer des favoris</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Ajouter « @book.Title » aux favoris">Ajouter aux favoris</button>
                            }
                        </form>

                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Changer le statut de « @book.Title »">
                                Statut
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (BookStatus status in System.Enum.GetValues<BookStatus>())
                                {
                                    if (status == book.Status)
                                    {
                                        continue;
                                    }
                                    <li>
                                        <form asp-action="UpdateStatus" method="post">
                                            <input type="hidden" name="id" value="@book.Id" />
                                            <input type="hidden" name="status" value="@((int)status)" />
                                            <button type="submit" class="dropdown-item">@StatusLabel(status)</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>

                        <button type="button" class="btn btn-sm btn-outline-danger ms-auto"
                                data-delete-book
                                data-book-id="@book.Id"
                                data-book-title="@book.Title"
                                data-bs-toggle="modal"
                                data-bs-target="#delete-confirmation-modal">
                            Supprimer
                        </button>
                    </div>
                </article>
            </div>
        }
    </div>

    <div class="modal fade" id="delete-confirmation-modal" tabindex="-1" aria-labelledby="delete-confirmation-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="delete-confirmation-title">Supprimer ce livre ?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p>Vous êtes sur le point de supprimer <strong data-book-title-target></strong> de votre bibliothèque.</p>
                    <p class="mb-0">Cette action est définitive et ne pourra pas être annulée.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="" />
                        <button type="submit" class="btn btn-danger">Supprimer définitivement</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/modal-confirmation.js" asp-append-version="true"></script>
}
