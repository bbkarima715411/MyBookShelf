@model List<MyBookShelf.Models.Book>

<h1>MyBookShelf</h1>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Status</td>

                <td>
                    <!-- DELETE -->
                    <form asp-action="Delete" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@book.Id" />
                        <button type="submit"> Delete</button>
                    </form>

                    <!-- UPDATE STATUS -->
                    <form asp-action="UpdateStatus" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@book.Id" />

                        <select name="status">
                            <option value="0">À lire</option>
                            <option value="1">En cours</option>
                            <option value="2">Lu</option>
                        </select>

                        <button type="submit"> Update</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
