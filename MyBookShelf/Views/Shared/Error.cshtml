@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="text-center py-5">
    <h1 class="h3 mb-3">Une erreur est survenue</h1>
    <p class="text-muted">
        Nous sommes désolés, mais une erreur inattendue s'est produite. Veuillez réessayer dans un instant.
    </p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Retour à l'accueil</a>
</div>

@if (Model.ShowRequestId)
{
    <p class="text-muted small mt-4">
        Référence : <code>@Model.RequestId</code>
    </p>
}
